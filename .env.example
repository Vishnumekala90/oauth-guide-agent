# Copy to .env (git-ignored). Never commit real keys.

# --- LLM (required for live generation) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Web search (required for live generation; pick ONE provider) ---
# tavily | brave | serper
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# --- Server ---
DATABASE_PATH=./data/guides.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GENERATE_RATE_LIMIT_PER_MINUTE=5

# --- Network ---
# Set to false ONLY behind an egress proxy that does DNS + filtering itself (hostname/IP rules still apply).
SSRF_DNS_CHECK=true
